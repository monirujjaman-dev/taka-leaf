  "narrative": {
    "northStar": "A tidy wallet in a green garden.",
    "overview": "Calm, exact personal finance for Bangladeshi taka: mint ground with two soft green glows, restrained frosted-glass surfaces, one confident forest green for the balance and the main action, and amounts as the heroes in heavy tabular Inter.",
    "keyCharacteristics": [
      "Numbers are the heroes: largest and heaviest type is always an amount, Bangladeshi grouping",
      "Restrained glass on surfaces that sit on the background; dialogs and inputs solid",
      "One primary colour used sparingly; leaf and amber only for progress",
      "Light and dark themes from one token set",
      "Phone: glass top bar, floating tab bar, round add button; desktop: glass sidebar"
    ],
    "rules": [
      "Money shown with formatBdt (৳1,25,000.00, minus −); typed as taka, stored as poisha",
      "Income/expense always with a sign and a colour; transfers neutral",
      "No sideways scroll at 390px; grids to one column; truncate long names",
      "Focus ring 2px primary, offset 2px, on every control"
    ],
    "dos": [
      "Lead each screen with the amount that answers its question",
      "Keep one primary button per view; destructive action on the opposite side",
      "Pair colour with words: Over budget, Owes you, +/−",
      "Check 390px and 1440px in light and dark"
    ],
    "donts": [
      "Glass on glass, blurred inputs or dialogs, low-contrast text on glows",
      "Gradient text, neon, glowing charts",
      "Red/green as the only income/expense difference",
      "Rounding amounts or Western 1,250,000 grouping",
      "Confetti, streaks, mascots, scolding alarm states",
      "Browser alert/confirm dialogs"
    ]
  }
