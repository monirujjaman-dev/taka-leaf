{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm --filter * *)",
      "Bash(pnpm vitest *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet restore *)",
      "Bash(dotnet list *)",
      "Bash(docker compose -f deploy/docker-compose.dev.yml *)",
      "Bash(docker build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checkout *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(bash .github/scripts/branch-kind.sh *)",
      "Bash(git push *)",
      "Bash(gh api *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr comment *)",
      "Bash(gh workflow run *)"
    ],
    "ask": [
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/appsettings.Production.json)",
      "Edit(./backend/TakaLeaf.App/Data/Migrations/**)",
      "Write(./backend/TakaLeaf.App/Data/Migrations/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(dotnet ef database drop *)",
      "Bash(git push origin main*)",
      "Bash(git push origin develop*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin HEAD:develop*)",
      "Bash(git tag -d *)",
      "Bash(gh release delete *)"
    ]
  }
}
