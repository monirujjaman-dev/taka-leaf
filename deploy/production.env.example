# TakaLeaf production settings for Dokploy (Application → Environment).
# Copy these into Dokploy, replace every <...>, and never commit the real values.

# Dokploy PostgreSQL service: use its Internal Host, not a public address.
ConnectionStrings__Database=Host=<internal-host>;Port=5432;Database=takaleaf;Username=takaleaf;Password=<database-password>

# Signs sign-in tokens. At least 32 characters; make one with: openssl rand -base64 48
# Changing it signs everyone out.
Auth__SigningKey=<long-random-secret>

# The address people open. Links in emails (verify, reset password) point here.
App__WebBaseUrl=https://<your-domain>

# Outgoing email (any SMTP provider). Security: StartTls for port 587, SslOnConnect for 465.
Email__Host=<smtp-host>
Email__Port=587
Email__Security=StartTls
Email__Username=<smtp-username>
Email__Password=<smtp-password>
Email__From=TakaLeaf <no-reply@<your-domain>>

# Traefik (Dokploy's proxy) reaches the app over Docker's private network. Trusting it lets
# the request logs and the sign-in rate limit see each visitor's real IP address.
ReverseProxy__TrustedNetworks__0=10.0.0.0/8

# Optional: also send logs to a Seq server.
# Serilog__WriteTo__2__Name=Seq
# Serilog__WriteTo__2__Args__serverUrl=http://<seq-internal-host>:80
