{
  "expo": {
    "name": "TakaLeaf",
    "slug": "takaleaf",
    "scheme": "takaleaf",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.takaleaf.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#E7F5EC"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-background-task",
      "expo-secure-store",
      "expo-status-bar",
      "expo-notifications",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-foreground.png",
          "imageWidth": 160,
          "backgroundColor": "#E7F5EC",
          "dark": {
            "image": "./assets/adaptive-foreground.png",
            "backgroundColor": "#0A1F15"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (expo-background-task) creates its Room database by reflection; R8 must keep the constructors.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { <init>(...); }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "defaultServerUrl": "https://takaleaf.monirujjaman.dev"
    }
  }
}
