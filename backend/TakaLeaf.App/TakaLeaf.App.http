# Requests to try the API by hand (VS Code REST Client, Rider or Visual Studio).
# Emails sent in development arrive in Mailpit: http://localhost:8025

@api = http://localhost:5080/api
@email = you@example.com
@password = green-leaf-2026

### Health
GET {{api}}/health

### Register
POST {{api}}/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### Verify email - paste the token from the link in the email
POST {{api}}/auth/verify-email
Content-Type: application/json

{ "token": "PASTE-TOKEN-HERE" }

### Sign in ("mobile" returns the refresh token in the body; the web app uses a cookie)
# @name login
POST {{api}}/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "client": "mobile" }

### Who am I
GET {{api}}/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

### Refresh
POST {{api}}/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login.response.body.refreshToken}}" }

### Sign out
POST {{api}}/auth/logout
Authorization: Bearer {{login.response.body.accessToken}}

### Forgot password - the reset link arrives in Mailpit
POST {{api}}/auth/forgot-password
Content-Type: application/json

{ "email": "{{email}}" }

### Reset password - paste the token from the link in the email
POST {{api}}/auth/reset-password
Content-Type: application/json

{ "token": "PASTE-TOKEN-HERE", "password": "a-new-green-leaf-27" }

### Change password (signed in)
POST {{api}}/auth/change-password
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "currentPassword": "{{password}}", "newPassword": "a-new-green-leaf-27" }

### Wallets (signed in)
GET {{api}}/wallets
Authorization: Bearer {{login.response.body.accessToken}}

### Add a wallet (amounts in poisha: 625000 = ৳6,250.00)
POST {{api}}/wallets
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "type": "Mfs", "name": "bKash", "openingBalance": 625000, "icon": "phone" }

### Add a credit card
POST {{api}}/wallets
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "type": "CreditCard", "name": "Credit card", "creditLimit": 10000000 }

### Expense categories with sub-categories
GET {{api}}/categories?kind=Expense
Authorization: Bearer {{login.response.body.accessToken}}

### Add a category
POST {{api}}/categories
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{ "kind": "Expense", "name": "Pets", "icon": "paw" }
