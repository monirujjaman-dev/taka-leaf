{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimits": {
    "AuthPerMinute": 20
  }
}
